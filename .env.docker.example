APP_NAME="E-Budget"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# WAJIB diisi URL publik yang diakses user (tanpa trailing slash), contoh:
#   APP_URL=https://ebudget.domainkamu.com   (di belakang reverse proxy + SSL)
#   APP_URL=http://IP-SERVER:8080            (akses langsung tanpa proxy)
APP_URL=http://localhost:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database (Gunakan nama container database yang sudah ada di global-network)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=e_budget
DB_USERNAME=postgres
DB_PASSWORD=secret_password_here

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Docker Port Mapping
APP_PORT=8080

# Docker Container Resource Limits
# 1. App (PHP-FPM 8.4)
APP_CPU_LIMIT=1.5
APP_MEM_LIMIT=1024M
APP_CPU_RESERVATION=0.25
APP_MEM_RESERVATION=256M

# 2. Web (Nginx)
WEB_CPU_LIMIT=0.5
WEB_MEM_LIMIT=256M
WEB_CPU_RESERVATION=0.10
WEB_MEM_RESERVATION=64M

# 3. Queue Worker (Opsional)
# QUEUE_CPU_LIMIT=0.5
# QUEUE_MEM_LIMIT=512M
# QUEUE_CPU_RESERVATION=0.10
# QUEUE_MEM_RESERVATION=128M
